SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use local SQLite (db.sqlite3).
# Railway fills this in automatically when you add a PostgreSQL service.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Optional. Railway HTTPS login also trusts RAILWAY_PUBLIC_DOMAIN automatically.
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
